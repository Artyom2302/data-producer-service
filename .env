# Тестовые значения для локальной разработки: база из docker-compose.yaml.
# Не используйте их вне локального окружения.
CONFIG_PATH=./config/config.yaml

POSTGRES_DB=data_producer_service
POSTGRES_USER=data_producer_service
POSTGRES_PASSWORD=data_producer_service

DSN_URL=postgres://data_producer_service:data_producer_service@localhost:5433/data_producer_service?sslmode=disable
